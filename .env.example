# Copy this file to .env.local and fill in only what you need — every
# feature below degrades gracefully when its variables are missing (the
# section comments say exactly what you lose by skipping it). See the
# README's "Run locally" section for the full walkthrough.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Core (no setup needed to run `npm run dev`)
# ---------------------------------------------------------------------------
# Everything in this section is optional for local dev. NextAuth signs its
# session JWTs with a fixed development secret when AUTH_SECRET is unset and
# NODE_ENV isn't "production" (see auth.js), so you only need this in
# production or if you want a stable secret across restarts.
# AUTH_SECRET=

# Base URL the app considers itself to be running at. Only needed for
# absolute-URL generation (e.g. metadata, sitemap); defaults are fine for
# `npm run dev` on the default port.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local database (analytics, admin panel, finance tracker, job search)
# ---------------------------------------------------------------------------
# All three features share one MySQL database via this same variable
# (each also accepts a feature-specific override — see below). Without it,
# analytics/finance/job-search all no-op instead of erroring: the site still
# renders, stats report zero, and finance/job-search redirect to their login
# pages.
#
# Quickest local setup: `npm run db:up` (starts MySQL in Docker via
# docker-compose.yml), then:
#   DATABASE_URL=mysql://root:devpassword@localhost:3306/portfolio
#
# On Railway, set this as a reference variable to ${{MySQL.MYSQL_URL}}.
# DATABASE_URL=mysql://root:devpassword@localhost:3306/portfolio

# Optional per-feature overrides, only needed if that feature should use a
# *different* database than DATABASE_URL:
# FINANCE_DATABASE_URL=
# JOB_SEARCH_DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin panel (/admin) — visitor analytics + chat log viewer
# ---------------------------------------------------------------------------
# Required just to unlock /admin locally — without it every /admin route
# returns 503. Pick any string, then sign in at /admin/login with it as the
# password.
# ANALYTICS_ADMIN_TOKEN=dev-admin-token

# ---------------------------------------------------------------------------
# Contact form (Resend)
# ---------------------------------------------------------------------------
# Without these the contact form's send fails; nothing else on the site is
# affected. Resend's onboarding@resend.dev sender works for local testing
# without verifying your own domain.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
# CONTACT_TO=your_destination_email@example.com

# ---------------------------------------------------------------------------
# AI portfolio chat assistant (Gemini)
# ---------------------------------------------------------------------------
# The chat widget itself always renders; sending a message needs BOTH a
# signed-in NextAuth session (any provider below) AND a Gemini key — without
# the key it replies with a clear "not configured" error instead of crashing.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# OAuth sign-in (GitHub / Google / LinkedIn / Microsoft Entra ID)
# ---------------------------------------------------------------------------
# Each provider is only registered with NextAuth when its own ID+secret pair
# is set (see auth.js) — with none set, no sign-in button appears anywhere
# and every session-gated feature (chat, finance, job search) is unreachable
# except via the FINANCE_DEV_BYPASS / JOB_SEARCH_DEV_BYPASS shortcuts below.
#
# GitHub is the fastest to set up for local testing: create a free OAuth App
# at https://github.com/settings/developers ("New OAuth App") with
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# then paste its Client ID / Client Secret below.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Google sign-in also gates the job-search "Check Email" Gmail helper further
# down — reuse the same client there if you need both.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ---------------------------------------------------------------------------
# Finance tracker (/finance) — owner-only
# ---------------------------------------------------------------------------
# Needs the local database above (npm run db:init:finance to create its
# tables, add --seed for sample bills/goals). Real access is restricted to
# FINANCE_ALLOWED_EMAILS via OAuth sign-in; for local testing, skip OAuth
# entirely with the bypass flag instead (ignored when NODE_ENV=production).
# FINANCE_ALLOWED_EMAILS=laurenceburce@gmail.com
# FINANCE_TOKEN_SECRET=use_a_long_private_random_string
# FINANCE_DEV_BYPASS=true

# Linked bank accounts are optional on top of the above:
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_REDIRECT_URI=http://localhost:3000/finance
# BRANKAS_LINK_URL=
# BRANKAS_REDIRECT_URI=http://localhost:3000/finance/brankas/callback
# BRANKAS_INSTITUTION_NAME=Brankas
# BRANKAS_APPEND_QUERY_PARAMS=false

# ---------------------------------------------------------------------------
# Job search dashboard (/job-search) — owner-only
# ---------------------------------------------------------------------------
# Needs the local database above (npm run db:init:job-search). Same
# owner-only gating as finance, with the same kind of dev-only bypass.
# JOB_SEARCH_ALLOWED_EMAILS=laurenceburce@gmail.com
# JOB_SEARCH_DEV_BYPASS=true

# Everything past this point drives real posting discovery, LLM scoring, and
# Playwright-driven ATS submission against live company sites — there's no
# safe local stand-in for "actually apply to a real job," so these are only
# worth setting if you intend to run the feature for real, not to test it in
# isolation. See docs/job-search-submit-worker-deployment.md for the
# submit-worker's separate always-on service.
# JOB_SEARCH_GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=
# GEMINI_JOB_SCORE_MODEL=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOB_SEARCH_PLAYWRIGHT_HEADLESS=true
# JOB_SEARCH_STORAGE_HALT_MB=
# JOB_SEARCH_SUBMIT_WORKER_URL=
# JOB_SEARCH_SUBMIT_WORKER_PORT=
# JOB_SEARCH_SUBMIT_TRIGGER_SECRET=
# JOB_SEARCH_REMOTE_CDP_ENDPOINT=
# JOB_SEARCH_REMOTE_CDP_TIMEOUT_MS=
# BRIGHTDATA_BROWSER_CDP_ENDPOINT=
# BROWSERLESS_CDP_ENDPOINT=
# JOB_SEARCH_CDP_MOUSE_ENABLED=
# JOB_SEARCH_LIVE_FRAME_INTERVAL_MS=
# JOB_SEARCH_LIVE_FRAME_JPEG_QUALITY=
# JOB_SEARCH_CAPTCHA_WAIT_MS=
# JOB_SEARCH_CAPTCHA_PAGE_CHECK_INTERVAL_MS=
# JOB_SEARCH_SECURITY_CODE_WAIT_MS=

# Web push (browser notifications when a security-code prompt needs you) —
# generate a pair with `npx web-push generate-vapid-keys`.
# JOB_SEARCH_VAPID_PUBLIC_KEY=
# JOB_SEARCH_VAPID_PRIVATE_KEY=
# JOB_SEARCH_VAPID_SUBJECT=mailto:you@example.com

# "Check Email" Gmail helper for security-code prompts — see the README for
# the full explanation of each variable.
# JOB_SEARCH_EMAIL_PROVIDER=gmail
# JOB_SEARCH_GMAIL_REFRESH_TOKEN=
# JOB_SEARCH_GMAIL_CLIENT_ID=
# JOB_SEARCH_GMAIL_CLIENT_SECRET=
# JOB_SEARCH_EMAIL_LOOKBACK_MINUTES=10
# JOB_SEARCH_EMAIL_MAX_RESULTS=20
# JOB_SEARCH_GMAIL_LABEL_IDS=INBOX
# JOB_SEARCH_EMAIL_SEARCH_QUERY=
