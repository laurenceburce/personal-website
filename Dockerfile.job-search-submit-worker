# Dockerfile for the job-search-submit-worker Railway service ONLY.
#
# The main web app and job-search-poll-worker services use Railway's default
# builder (Railpack/Nixpacks) with no Dockerfile at all — do not rename this
# file to plain "Dockerfile" at the repo root, since Railway auto-detects and
# prioritizes any root-level Dockerfile for every service sharing that root
# directory, which would silently switch the main app's build too. This file
# is opted into only via the RAILWAY_DOCKERFILE_PATH service variable set on
# the submit-worker service (see the deployment instructions).
#
# Playwright's Chromium needs OS-level libraries (libnss3, libgbm1, etc.) that
# Railway's default builder environment can't install — this is Railway's own
# documented approach for Playwright: https://docs.railway.com/guides/playwright
FROM node:22-bookworm

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Installs Chromium plus every OS-level library it needs, matching whatever
# playwright version package-lock.json actually resolved to — this avoids
# ever having to hand-pin a Docker base image tag to a specific playwright
# patch version (Microsoft doesn't publish an image for every patch release).
RUN npx playwright install --with-deps chromium

COPY . .

ENV JOB_SEARCH_PLAYWRIGHT_HEADLESS=true
# Matches the server's own default (scripts/job-search-submit-worker-server.mjs)
# — set explicitly here so it's visible/discoverable from the Dockerfile
# without having to go read the script. Only reachable over Railway's private
# network (<service>.railway.internal:8080) — never attach a public domain to
# this service. JOB_SEARCH_SUBMIT_TRIGGER_SECRET is required too (set as a
# Railway service variable, not baked into the image) — see the deployment
# instructions for the full env var list.
ENV JOB_SEARCH_SUBMIT_WORKER_PORT=8080
EXPOSE 8080

# The event-driven persistent server (see its own header comment) — replaces
# the old one-shot script as this service's Start Command. No Railway Cron
# Schedule needed anymore: the server's own internal fallback timer
# (JOB_SEARCH_SUBMIT_FALLBACK_INTERVAL_MINUTES, default 10) replaces it.
# scripts/job-search-submit-worker.mjs (the one-shot script) still exists for
# local/manual dry-run testing — it's just no longer what this container runs.
CMD ["node", "scripts/job-search-submit-worker-server.mjs"]
